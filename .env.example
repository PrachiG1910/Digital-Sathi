# ====================================================================
# Digital Sathi Environment Variables Template (Example Placeholders Only)
# DO NOT put real secrets or credentials in this file.
# ====================================================================

# Frontend / Client Configuration (Vercel)
# In production on Vercel, set this to your Render backend service URL (e.g. https://digital-sathi-backend.onrender.com).
# In local development, leave this empty to use Vite's internal dev proxy.
VITE_API_URL="http://localhost:5001"

# Backend Server Configuration (Render)
PORT=5001
HOST="0.0.0.0"
NODE_ENV="development"

# MongoDB Database Configuration (Render / Atlas)
# In production, provide your MongoDB Atlas connection string:
# e.g. MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority"
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB_NAME="digital_sathi"

# Google Gemini API Key (Backend AI Guide)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Application URL (Frontend origin)
APP_URL="http://localhost:3000"
